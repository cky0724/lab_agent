# ========================================
# 智能实验室预约系统 - 后端环境变量模板
# 使用方式：复制本文件为 .env 后填入真实值，切勿提交 .env 到版本库
#   Windows:  copy example.env .env
#   Linux:    cp example.env .env
# ========================================

# ---- 数据库连接（MySQL）----
# 格式：mysql+pymysql://<用户名>:<密码>@<主机>:<端口>/<数据库名>
# 注意：数据库需要提前创建（默认库名 lab_agent），可导入 sql/lab_agent.sql 初始化
DATABASE_URL=

# ---- JWT 配置 ----
# 签名密钥：建议使用随机长字符串，例如 openssl rand -hex 32
JWT_SECRET_KEY=
# 签名算法（默认 HS256，可留空）
JWT_ALGORITHM=HS256
# Token 有效期（小时，默认 24，可留空）
JWT_EXPIRE_HOURS=24

# ---- 大模型配置（阿里云百炼 DashScope 兼容模式）----
# API Key（必须填写，否则 AI 助手不可用）
LLM_API_KEY=
# 兼容 OpenAI 格式的接口地址，形如：https://<专属节点>.maas.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
# 模型名称，例如 qwen-plus
LLM_MODEL=qwen-plus