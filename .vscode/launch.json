{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.main:app"
      ],
      "jinja": true,
      "justMyCode": false,
      "subProcess": true,
      "env": {
            "HF_HUB_OFFLINE":"1",
            "HF_DATASETS_OFFLINE":"1"
      }
    }
  ]
}